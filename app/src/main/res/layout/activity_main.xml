<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <!-- ヘッダー -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:background="#1F1F1F"
        android:gravity="center_vertical"
        android:paddingHorizontal="2dp"
        android:elevation="10dp">

        <!-- ブラウザ操作ボタン -->
        <ImageButton android:id="@+id/btnBack" android:layout_width="35dp" android:layout_height="match_parent" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_media_rew" app:tint="#AAAAAA" android:contentDescription="戻る" />
        <ImageButton android:id="@+id/btnForward" android:layout_width="35dp" android:layout_height="match_parent" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_media_ff" app:tint="#AAAAAA" android:contentDescription="進む" />

        <!-- URL入力欄 (Goボタン削除、検索対応) -->
        <EditText android:id="@+id/editUrl" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:background="#333333" android:hint="検索 または URL" android:imeOptions="actionSearch" android:inputType="textUri" android:paddingHorizontal="10dp" android:textSize="13sp" android:maxLines="1" android:textColor="#FFFFFF" android:textColorHint="#888888" android:layout_marginHorizontal="5dp"/>

        <ImageButton android:id="@+id/btnStar" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/btn_star_big_off" app:tint="#FFFFFF" android:contentDescription="お気に入り" />
        <ImageButton android:id="@+id/btnMenu" android:layout_width="45dp" android:layout_height="match_parent" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_more" app:tint="#FFFFFF" android:scaleType="center" android:contentDescription="メニュー" />
    </LinearLayout>

    <!-- コンテンツエリア -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/myWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 設定パネル -->
        <ScrollView
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2D2D2D"
            android:padding="15dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="解析設定" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                    <Button android:id="@+id/btnCloseSettings" android:layout_width="wrap_content" android:layout_height="36dp" android:text="閉じる ✕" android:backgroundTint="#444444" android:textColor="#FFFFFF" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp"/>
                </LinearLayout>

                <!-- 便利ツールエリア -->
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnTestRun" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🧪 テスト解析" android:backgroundTint="#00897B" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginEnd="5dp"/>
                        <ToggleButton android:id="@+id/toggleInspectMode" android:layout_width="wrap_content" android:layout_height="40dp" android:textOn="👆 選択モードON" android:textOff="👆 要素選択" android:background="#555555" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginEnd="5dp"/>
                        <ToggleButton android:id="@+id/toggleImages" android:layout_width="wrap_content" android:layout_height="40dp" android:textOn="🖼️ 画像: ON" android:textOff="🖼️ 画像: OFF" android:checked="true" android:background="#555555" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#404040" android:padding="10dp" android:layout_marginBottom="10dp">
                    <TextView android:text="設定プリセット" android:textColor="#AAAAAA" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerPresets" android:layout_width="match_parent" android:layout_height="40dp" android:background="#555555" android:layout_marginBottom="5dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnSavePreset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="保存" android:backgroundTint="#9E9E9E" android:textSize="10sp" android:layout_marginEnd="5dp" android:insetTop="0dp" android:insetBottom="0dp"/>
                        <Button android:id="@+id/btnDeletePreset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="削除" android:backgroundTint="#D32F2F" android:textSize="10sp" android:insetTop="0dp" android:insetBottom="0dp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="① 本文の要素" android:textSize="12sp" android:textColor="#80CBC4"/>
                <EditText android:id="@+id/editBodySelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="#novel_content" android:textSize="14sp" android:textColor="#FFFFFF" android:inputType="text"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="② ファイル名(タイトル)要素" android:textSize="12sp" android:textColor="#80CBC4" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editTitleSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=".toon-title" android:textSize="14sp" android:textColor="#FFFFFF" android:inputType="text"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="③ ファイル名整形(Regex)" android:textSize="12sp" android:textColor="#80CBC4" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editFileRegex" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:hint="例: \(.*?\)" android:textSize="14sp" android:textColor="#FFFFFF" android:textColorHint="#888888" android:inputType="textNoSuggestions"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="④ フォルダ名要素" android:textSize="12sp" android:textColor="#F48FB1" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editFolderSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=".toon-title" android:hint="空欄なら固定" android:textSize="14sp" android:textColor="#FFFFFF" android:textColorHint="#888888" android:inputType="text"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑤ フォルダ名取得リンク(Selector)" android:textSize="12sp" android:textColor="#F48FB1" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editFolderLinkSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:hint="空欄なら現在ページで取得" android:textSize="14sp" android:textColor="#FFFFFF" android:textColorHint="#888888" android:inputType="text"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑥ フォルダ名整形(Regex)" android:textSize="12sp" android:textColor="#F48FB1" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editFolderRegex" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FFFFFF" android:inputType="textNoSuggestions"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑦ チャプター番号要素" android:textSize="12sp" android:textColor="#9FA8DA" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editChapterSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FFFFFF" android:inputType="text"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑧ チャプター抽出Regex" android:textSize="12sp" android:textColor="#9FA8DA" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editChapterRegex" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:hint="空欄なら最初の数字" android:textSize="14sp" android:textColor="#FFFFFF" android:textColorHint="#888888" android:inputType="textNoSuggestions"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑨ 次へリンク要素" android:textSize="12sp" android:textColor="#FFCC80" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editNextSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="#goNextBtn" android:textSize="14sp" android:textColor="#FFFFFF" android:inputType="text"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑩ 待機時間 (秒/範囲)" android:textSize="12sp" android:textColor="#FFCC80" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editDelay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15-30" android:textSize="14sp" android:textColor="#FFFFFF" android:inputType="text"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑪ 終了条件(URL/Regex)" android:textSize="12sp" android:textColor="#FF5252" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editEndCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="list|index|toc|javascript" android:textSize="14sp" android:textColor="#FFFFFF" android:inputType="text"/>

                <!-- 新規追加: 自動適用キーワード -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⑫ 自動適用キーワード(URLに含まれる文字)" android:textSize="12sp" android:textColor="#B2FF59" android:layout_marginTop="5dp"/>
                <EditText android:id="@+id/editAutoUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:hint="例: booktoki (空欄で無効)" android:textSize="14sp" android:textColor="#FFFFFF" android:textColorHint="#888888" android:inputType="text"/>

                <View android:layout_width="match_parent" android:layout_height="50dp"/>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@android:drawable/ic_media_play"
            android:backgroundTint="#FF5722"
            app:borderWidth="0dp"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="待機中"
        android:background="#222222"
        android:textColor="#CCCCCC"
        android:gravity="center"
        android:padding="4dp"
        android:textSize="11sp"/>
</LinearLayout>