    {
      "dot": "amber",
      "title": "Code Duplication Points",
      "items": [
        "TextIngest (common vs v2): ~1000 lines of charset detection cloned",
        "NovelPhysicalSplitter vs PreSplit: duplicate splitSingleTextFile logic",
        "Cleanser tripled across common, PreSplit, and RunEngine"
      ]
    },
    {
      "dot": "rose",
      "title": "Redundant Multi-Stage Points",
      "items": [
        "Double Chunking: Physical PreSplit -> Subfolder -> Chunking in translateLarge",
        "Double Prompt Loop: Outer Attempt list loop x Inner Rotation loop (NxN)",
        "Prompt Re-build: Full prompt assembly string split and replaced in call()",
        "Dict Gen: Merge call immediately followed by Review call to same model",
        "Batch Post-Query: Heavy findChild IPC queries run right after writeText"
      ]
    }
